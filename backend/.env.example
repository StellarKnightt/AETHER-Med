# ============================================
# AETHER-Med Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Application ---
APP_NAME=AETHER-Med
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://aether:aether_secret@localhost:5432/aether_med
DATABASE_ECHO=false

# --- ChromaDB ---
CHROMADB_HOST=localhost
CHROMADB_PORT=8001

# --- LLM Providers ---
DEFAULT_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Embeddings ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- CORS ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
